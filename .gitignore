# MATLAB autosave
*.asv

# Large data / outputs (adjust to your needs)
*.mat
*.tif

# Reference data is an INPUT, not an output. Small, third-party, and the code
# cannot run without it -- see the folder's own README for provenance
!07_figuregeneration/allen/*.mat

# Archive of legacy/unused files
# 99_notinuse/
ecspress_main.asv

# Third-party dependencies
04_analysis/04_piv/pivlab_thirdparty/

# Deliberately compact copies kept for sharing. They duplicate pipeline code on
# purpose and must NOT be edited to match it -- versioning them would invite that
functions/toshare/

# Scratch pad. Whatever is being tried right now, by design
untitled.m
